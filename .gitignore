# ── SECRETS / machine state — NEVER commit ──────────────────────────────────
**/.credentials.json
**/.claude.json
# Claude Code auto-rotates these — they are full copies of .claude.json
**/.claude.json.backup.*
.env
.env.*
!.env.example
*.key
*.pem
*.token
*.secret

# Claude per-machine / runtime state (not portable config)
# Claude Code regenerates the native-host wrapper dir each launch
/chrome/
# plugin runtime state — churning timestamps + machine-absolute paths
# (plugins are declared in claude/settings.json; the vendored marketplaces/ stays tracked)
/plugins/known_marketplaces.json
/plugins/installed_plugins.json
**/settings.local.json
**/settings.json.bak
**/settings.json.orig
**/history.jsonl
**/projects/
**/file-history/
**/shell-snapshots/
**/paste-cache/
**/session-env/
**/sessions/
**/todos/
**/.last-*
**/.caveman-active
**/.caveman-history.jsonl

# OS / editor noise
.DS_Store
*.swp
